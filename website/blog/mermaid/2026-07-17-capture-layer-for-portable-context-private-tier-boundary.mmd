graph LR
    subgraph private["✅ This Post: Private Tier Capture"]
        logs["📁 raw Copilot<br/>CLI logs<br/><br/>Sensitive data"]
        parser["🔍 local parser<br/>candidate<br/>extraction"]
    end
    
    subgraph future["🚀 Future Posts: Approval & Publishing"]
        ratify["📋 scrub +<br/>ratify<br/><br/>human review"]
        approved["✓ curated<br/>context repo<br/><br/>approved rules"]
    end
    
    subgraph untrustedZone["⚠️ Untrusted Surfaces"]
        untrusted["⚠️ untrusted<br/>AI surface<br/><br/>blocked access"]
    end
    
    logs -->|private read| parser
    parser -->|propose| ratify
    ratify -->|promote| approved
    untrusted -.->|blocked| logs
    approved -->|allowed read| untrusted
    
    style private fill:#fef9f5,stroke:#d4896b,stroke-width:3px,color:#3d2817
    style future fill:#fef9f5,stroke:#a0734d,stroke-width:2px,stroke-dasharray:5,color:#6b4423
