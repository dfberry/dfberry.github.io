%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, ui-sans-serif, system-ui",
    "primaryColor": "#f5e6d3",
    "primaryTextColor": "#3d2817",
    "primaryBorderColor": "#d4896b",
    "lineColor": "#c9956b",
    "secondaryColor": "#fdf4e8",
    "secondaryTextColor": "#3d2817",
    "secondaryBorderColor": "#b8836f",
    "tertiaryColor": "#f9ead8",
    "tertiaryTextColor": "#4a3428",
